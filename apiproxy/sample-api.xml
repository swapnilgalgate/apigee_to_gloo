<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy name="sample-api">
    <Description>Sample APIGEE proxy for migration to Gloo</Description>
    <Policies>
        <Policy>VerifyAPIKey</Policy>
        <Policy>AddHeaders</Policy>
        <Policy>RaiseInvalidKeyFault</Policy>
    </Policies>
    <ProxyEndpoints>
        <ProxyEndpoint>default</ProxyEndpoint>
    </ProxyEndpoints>
    <TargetEndpoints>
        <TargetEndpoint>default</TargetEndpoint>
    </TargetEndpoints>
</APIProxy>
